From f1c5412c76ceba3c04c94b880c8d3902fe408d58 Mon Sep 17 00:00:00 2001
From: Youff <asa.jazal@gmail.com>
Date: Sat, 4 Apr 2026 14:07:59 +0700
Subject: [PATCH 04/46] sched/fair: implement hybrid CASS and MTK scheduler

Introduce a hybrid scheduling approach by integrating CASS with the
existing MediaTek scheduler instead of fully replacing it.

Previously, CASS overrode select_task_rq_fair() via macro definition,
which completely bypassed the MTK scheduler logic. This change removes
the macro override and applies CASS selectively based on task utilization.

Heavy tasks (high util_est) are handled by CASS for improved performance,
while lighter tasks continue to use the default MTK scheduler path,
preserving vendor-specific optimizations and stability.

This approach reduces scheduling conflicts, avoids double decision-making,
and provides a better balance between performance and efficiency.

Key changes:
- Remove macro override of select_task_rq_fair
- Keep cass.c included without forcing full replacement
- Add hybrid decision logic in select_task_rq_fair()
- Use task_util_est() as threshold to dispatch between CASS and MTK

This ensures compatibility with MTK scheduler extensions while enabling
performance gains from CASS in high-load scenarios.

Signed-off-by: Youffx <asa.jazal@gmail.com>
---
 kernel/sched/fair.c | 22 +++++++++++++---------
 1 file changed, 13 insertions(+), 9 deletions(-)

diff --git a/kernel/sched/fair.c b/kernel/sched/fair.c
index 49fcb9f9779f..1aaa5381c07c 100644
--- a/kernel/sched/fair.c
+++ b/kernel/sched/fair.c
@@ -23,6 +23,10 @@
 #include "sched.h"
 
 #include <trace/events/sched.h>
+extern int cass_select_task_rq_fair(struct task_struct *p,
+				    int prev_cpu,
+				    int sd_flag,
+				    int wake_flags);
 
 /*
  * Targeted preemption latency for CPU-bound tasks:
@@ -7837,8 +7841,15 @@ select_task_rq_fair(struct task_struct *p, int prev_cpu, int sd_flag,
 	int result = 0;
 	int cpu;
 
-	result = SELECT_TASK_RQ_FAIR(p, prev_cpu, sd_flag, wake_flags,
-		sibling_count_hint);
+	int util = task_util_est(p);
+/* ==== HYBRID: CASS ==== */
+if (util > 300) {
+	return cass_select_task_rq_fair(p, prev_cpu,
+				       sd_flag, wake_flags);
+}
+/* ==== MTK scheduler ==== */
+    result = SELECT_TASK_RQ_FAIR(p, prev_cpu, sd_flag, wake_flags,
+	    sibling_count_hint);
 #ifdef CONFIG_MTK_SCHED_CPU_PREFER
 	select_task_prefer_cpu_fair(p, &result);
 #endif
@@ -12157,13 +12168,6 @@ static unsigned int get_rr_interval_fair(struct rq *rq, struct task_struct *task
 
 #ifdef CONFIG_SCHED_CASS
 #include "cass.c"
-
-/* Use CASS. A dummy wrapper ensures the replaced function is still "used". */
-static inline void *select_task_rq_fair_dummy(void)
-{
-	return (void *)select_task_rq_fair;
-}
-#define select_task_rq_fair cass_select_task_rq_fair
 #endif /* CONFIG_SCHED_CASS */
 
