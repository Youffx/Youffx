index b857a41d9f06..021572314701 100644
--- a/mm/vmscan.c
+++ b/mm/vmscan.c
@@ -2624,9 +2624,6 @@ static int get_swappiness(struct lruvec *lruvec, struct scan_control *sc)
 {
 	struct mem_cgroup *memcg = lruvec_memcg(lruvec);
 
-	if (mem_cgroup_get_nr_swap_pages(memcg) < MIN_LRU_BATCH)
-		return 0;
-
 	return mem_cgroup_swappiness(memcg);
 }
 

