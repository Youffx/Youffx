+
 /******************************************************************************
  *                          shorthand helpers
  ******************************************************************************/
@@ -2596,6 +2603,15 @@ static int page_lru_tier(struct page *page)
 	return lru_tier_from_refs(refs);
 }
 
+static bool get_cap(int cap)
+{
