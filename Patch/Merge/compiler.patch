From c435db5a8f94b8d29308ea5a070c027dbe493f61 Mon Sep 17 00:00:00 2001
From: Youff <asa.jazal@gmail.com>
Date: Thu, 23 Apr 2026 13:18:09 +0700
Subject: [PATCH 26/28] PGO: remove Clang version dependency for PGO support

---
 arch/arm64/Kconfig | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/arch/arm64/Kconfig b/arch/arm64/Kconfig
index 59976ee34a8c..3b2f24925976 100644
--- a/arch/arm64/Kconfig
+++ b/arch/arm64/Kconfig
@@ -60,7 +60,7 @@ config ARM64
 	select ARCH_SUPPORTS_MEMORY_FAILURE
 	select ARCH_SUPPORTS_LTO_CLANG
 	select ARCH_SUPPORTS_THINLTO
-	select ARCH_SUPPORTS_PGO if (CLANG_VERSION >= 170001 && CLANG_VERSION < 180000) || (GCC_VERSION >= 100100 && GCC_VERSION < 110000)
+	select ARCH_SUPPORTS_PGO
 	select ARCH_SUPPORTS_SHADOW_CALL_STACK if CC_HAVE_SHADOW_CALL_STACK
 	select ARCH_SUPPORTS_ATOMIC_RMW
 	select ARCH_SUPPORTS_INT128 if GCC_VERSION >= 50000 || CC_IS_CLANG

