From 653377582ce34a3595a7758a98916c611c97cf81 Mon Sep 17 00:00:00 2001
From: Youff <asa.jazal@gmail.com>
Date: Mon, 6 Apr 2026 00:15:50 +0700
Subject: [PATCH 1/8] cpuidle: menu: Simplify latency constraint handling via unified helper

Refactor the menu governor selection mechanism to retrieve CPU latency
requirements using the unified cpuidle_governor_latency_req() helper. 
This replaces manual evaluations of PM QoS and device-specific raw resume 
latencies, streamlining the logic and allowing the removal of redundant 
header inclusions.
---
 drivers/cpuidle/governors/menu.c | 10 +---------
 1 file changed, 1 insertion(+), 9 deletions(-)

diff --git a/drivers/cpuidle/governors/menu.c b/drivers/cpuidle/governors/menu.c
index c7820a09fa65..436807afcd83 100644
--- a/drivers/cpuidle/governors/menu.c
+++ b/drivers/cpuidle/governors/menu.c
@@ -12,7 +12,6 @@
 
 #include <linux/kernel.h>
 #include <linux/cpuidle.h>
-#include <linux/pm_qos.h>
 #include <linux/time.h>
 #include <linux/ktime.h>
 #include <linux/hrtimer.h>
@@ -21,7 +20,6 @@
 #include <linux/sched/loadavg.h>
 #include <linux/sched/stat.h>
 #include <linux/math64.h>
-#include <linux/cpu.h>
 
 /*
  * Please note when changing the tuning values:
@@ -298,15 +296,13 @@ static int menu_select(struct cpuidle_driver *drv, struct cpuidle_device *dev,
 		       bool *stop_tick)
 {
 	struct menu_device *data = this_cpu_ptr(&menu_devices);
-	struct device *device = get_cpu_device(dev->cpu);
-	int latency_req = pm_qos_request(PM_QOS_CPU_DMA_LATENCY);
+	int latency_req = cpuidle_governor_latency_req(dev->cpu);
 	int i;
 	int first_idx;
 	int idx;
 	unsigned int interactivity_req;
 	unsigned int expected_interval;
 	unsigned long nr_iowaiters, cpu_load;
-	int resume_latency = dev_pm_qos_raw_read_value(device);
 	ktime_t delta_next;
 
 	if (data->needs_update) {
@@ -314,10 +310,6 @@ static int menu_select(struct cpuidle_driver *drv, struct cpuidle_device *dev,
 		data->needs_update = 0;
 	}
 
-	/* resume_latency is 0 means no restriction */
-	if (resume_latency && resume_latency < latency_req)
-		latency_req = resume_latency;
-
 	/* Special case when user has set very strict latency requirement */
 	if (unlikely(latency_req == 0)) {
 		*stop_tick = false;

From 2d96740b10b59ca3d388b034f4b76f10fd3848ee Mon Sep 17 00:00:00 2001
From: Youff <asa.jazal@gmail.com>
Date: Mon, 6 Apr 2026 00:22:28 +0700
Subject: [PATCH 2/8] rosemary_defconfig: Enable TEO and standard cpuidle infrastructure

Update the defconfig to enable generic CPU idle subsystem support,
allowing multiple drivers. Build both the standard Menu governor and 
the Timer Events Oriented (TEO) governor to enhance CPU idle precision 
and power efficiency options.
---
 arch/arm64/configs/rosemary_defconfig | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/arch/arm64/configs/rosemary_defconfig b/arch/arm64/configs/rosemary_defconfig
index a85289a4b5d2..5866f12c11b4 100644
--- a/arch/arm64/configs/rosemary_defconfig
+++ b/arch/arm64/configs/rosemary_defconfig
@@ -26,6 +26,14 @@ CONFIG_MTK_SCHED_TRACERS=n
 CONFIG_MTK_SCHED_CPU_PREFER=n
 CONFIG_MTK_SCHED_BIG_TASK_MIGRATE=n
 CONFIG_SCHED_CASS=y
+CONFIG_CPU_IDLE=y
+CONFIG_CPU_IDLE_MULTIPLE_DRIVERS=y
+# CONFIG_CPU_IDLE_GOV_LADDER is not set
+CONFIG_CPU_IDLE_GOV_MENU=y
+# CONFIG_CPU_IDLE_GOV_MTK is not set
+CONFIG_CPU_IDLE_GOV_MTK_MENU=y
+# CONFIG_CPU_IDLE_NO_MTK is not set
+CONFIG_CPU_IDLE_GOV_TEO=y
 # CONFIG_SLUB_DEBUG is not set
 CONFIG_MACH_MT6785=y
 CONFIG_CFQ_GROUP_IOSCHED=y

From d50637ae3c0eabd0e56281c5e6056c956985007d Mon Sep 17 00:00:00 2001
From: Youff <asa.jazal@gmail.com>
Date: Mon, 6 Apr 2026 00:27:34 +0700
Subject: [PATCH 3/8] cpuidle: teo: Elevate governor rating to override defaults

Increase the rating of the TEO governor from 19 to 150. This adjustment
ensures the kernel prioritizes and automatically selects TEO over other 
built-in governors like Menu when initializing CPU idle states.
---
 drivers/cpuidle/governors/teo.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/drivers/cpuidle/governors/teo.c b/drivers/cpuidle/governors/teo.c
index f376f4caccb4..69eb812ac5a5 100644
--- a/drivers/cpuidle/governors/teo.c
+++ b/drivers/cpuidle/governors/teo.c
@@ -524,7 +524,7 @@ static int teo_enable_device(struct cpuidle_driver *drv,
 
 static struct cpuidle_governor teo_governor = {
 	.name =		"teo",
-	.rating =	19,
+	.rating =	150,
 	.enable =	teo_enable_device,
 	.select =	teo_select,
 	.reflect =	teo_reflect,

