From af1c6e3e81e7b0f02480d2e23556cc2f9c3ecae3 Mon Sep 17 00:00:00 2001
From: Youff <asa.jazal@gmail.com>
Date: Mon, 6 Apr 2026 01:49:32 +0700
Subject: [PATCH 5/8] rosemary_defconfig: Isolate cpuidle implementation from MTK extensions

Enforce upstream cpuidle behavior by enabling CONFIG_CPU_IDLE_NO_MTK.
This removes the proprietary MediaTek menu governor additions from the build
to avoid side effects and rely fully on TEO.
---
 arch/arm64/configs/rosemary_defconfig | 4 +---
 1 file changed, 1 insertion(+), 3 deletions(-)

diff --git a/arch/arm64/configs/rosemary_defconfig b/arch/arm64/configs/rosemary_defconfig
index 5866f12c11b4..d4fcca218031 100644
--- a/arch/arm64/configs/rosemary_defconfig
+++ b/arch/arm64/configs/rosemary_defconfig
@@ -30,9 +30,7 @@ CONFIG_CPU_IDLE=y
 CONFIG_CPU_IDLE_MULTIPLE_DRIVERS=y
 # CONFIG_CPU_IDLE_GOV_LADDER is not set
 CONFIG_CPU_IDLE_GOV_MENU=y
-# CONFIG_CPU_IDLE_GOV_MTK is not set
-CONFIG_CPU_IDLE_GOV_MTK_MENU=y
-# CONFIG_CPU_IDLE_NO_MTK is not set
+CONFIG_CPU_IDLE_NO_MTK=y
 CONFIG_CPU_IDLE_GOV_TEO=y
 # CONFIG_SLUB_DEBUG is not set
 CONFIG_MACH_MT6785=y

From e245bc383e653ea2136aa07a8153fb45d9b33926 Mon Sep 17 00:00:00 2001
From: Youff <asa.jazal@gmail.com>
Date: Mon, 6 Apr 2026 01:59:43 +0700
Subject: [PATCH 6/8] cpuidle: Kconfig: Set CPU_IDLE_NO_MTK to true by default

Modify the cpuidle Kconfig structural rules to set CPU_IDLE_NO_MTK 
to default to yes. This prevents the default inclusion of proprietary 
MediaTek driver logic across generic platform targets.
---
 drivers/cpuidle/Kconfig | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/drivers/cpuidle/Kconfig b/drivers/cpuidle/Kconfig
index b7a3fc519f62..177cfffbb527 100644
--- a/drivers/cpuidle/Kconfig
+++ b/drivers/cpuidle/Kconfig
@@ -51,12 +51,14 @@ config CPU_IDLE_GOV_MTK_MENU
 
 config CPU_IDLE_NO_MTK
 	bool "Disable MTK related cpuidle driver / governor"
+	default y
 	help
 	  MTK added many proprietary cpuidle drivers and governors.
 	  And some of them set to be default for all projects.
 	  But not all (MTK) projects use these driver.
 	  Set this option to avoid using MTK driver / gorvernor by default.
 
+
 config DT_IDLE_STATES
 	bool
 

