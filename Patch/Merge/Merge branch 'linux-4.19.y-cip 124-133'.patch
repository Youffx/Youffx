 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/net/rose/af_rose.c b/net/rose/af_rose.c
index a2f3080e032eec..8c27a526b4361f 100644
--- a/net/rose/af_rose.c
+++ b/net/rose/af_rose.c
@@ -207,7 +207,7 @@ start:
 	spin_unlock_bh(&rose_list_lock);
 
 	for (i = 0; i < cnt; i++) {
-		sk = array[cnt];
