@@ -1394,7 +1395,7 @@ static bool l2cap_check_enc_key_size(struct hci_conn *hcon)
 	int min_key_size = HCI_MIN_ENC_KEY_SIZE;
 
 	/* On FIPS security level, key size must be 16 bytes */
