-	case 0:
-		proto = guehdr->proto_ctype;
-		guehlen = sizeof(*guehdr) + (guehdr->hlen << 2);
-		break;
-	case 1:
-		switch (((struct iphdr *)guehdr)->version) {
-		case 4:
-			proto = IPPROTO_IPIP;
-			break;
-		case 6:
-			proto = IPPROTO_IPV6;
-			break;
-		default:
-			return err;
-		}
-		break;
-	default:
-		return err;
