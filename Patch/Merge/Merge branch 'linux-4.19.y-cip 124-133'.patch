--- a/net/bluetooth/mgmt.c
+++ b/net/bluetooth/mgmt.c
@@ -5087,6 +5087,9 @@ static bool ltk_is_valid(struct mgmt_ltk_info *key)
 	if (key->master != 0x00 && key->master != 0x01)
