 1 file changed, 1 insertion(+), 3 deletions(-)

diff --git a/net/ipv4/ping.c b/net/ipv4/ping.c
index 2e7abad48d83c4..33cdb858b33c43 100644
--- a/net/ipv4/ping.c
+++ b/net/ipv4/ping.c
@@ -857,10 +857,8 @@ out:
 out_free:
 	if (free)
 		kfree(ipc.opt);
-	if (!err) {
-		icmp_out_count(sock_net(sk), user_icmph.type);
+	if (!err)
 		return len;
-	}
