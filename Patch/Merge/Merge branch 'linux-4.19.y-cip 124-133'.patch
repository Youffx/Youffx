index 4bd4cb73764526..d845fb1051c5b3 100644
--- a/net/netfilter/nf_conncount.c
+++ b/net/netfilter/nf_conncount.c
@@ -178,14 +178,25 @@ static int __nf_conncount_add(struct net *net,
