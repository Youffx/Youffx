 net/ipv4/fou.c      | 1122 ---------------------------------------------------
 net/ipv4/fou_core.c | 1122 +++++++++++++++++++++++++++++++++++++++++++++++++++
 3 files changed, 1123 insertions(+), 1122 deletions(-)
 delete mode 100644 net/ipv4/fou.c
 create mode 100644 net/ipv4/fou_core.c

