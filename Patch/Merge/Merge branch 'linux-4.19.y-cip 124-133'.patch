@@ -442,6 +451,7 @@ static int lec_atm_send(struct atm_vcc *vcc, struct sk_buff *skb)
 			/* hit from bridge table, send LE_ARP_RESPONSE */
 			struct sk_buff *skb2;
 			struct sock *sk;
+			struct atm_vcc *vcc;
 
 			pr_debug("%s: entry found, responding to zeppelin\n",
