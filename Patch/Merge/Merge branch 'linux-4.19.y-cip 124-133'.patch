 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/fs/ext4/super.c b/fs/ext4/super.c
index aac1e5c2f663e7..40e36cf89b0d55 100644
--- a/fs/ext4/super.c
+++ b/fs/ext4/super.c
@@ -3834,10 +3834,11 @@ static int ext4_fill_super(struct super_block *sb, void *data, int silent)
 	}
 
 	if (sbi->s_es->s_mount_opts[0]) {
-		char s_mount_opts[65];
+		char s_mount_opts[64];
 
